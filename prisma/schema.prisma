generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  ADMIN
  MEMBER
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()"))
  name          String
  email         String         @unique
  password_hash String
  role          ROLE           @default(MEMBER)
  created_at    DateTime       @default(now())
  checkIns      CheckIn[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model CheckIn {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  created_at   DateTime  @default(now())
  validated_at DateTime?
  user         User      @relation(fields: [user_id], references: [id])
  user_id      String
  gym          Gym       @relation(fields: [gym_id], references: [id])
  gym_id       String

  @@map("check-ins")
}

model Gym {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  title       String
  description String?
  phone       String?
  latitude    Decimal
  longitude   Decimal
  deleted_at  DateTime?
  checkIns    CheckIn[]

  @@map("gyms")
}

model RefreshToken {
  id         String    @id
  user_id    String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh-tokens")
}
